# Secrets — never commit. Tokens live in Vault.
.env
.env.*
*.pem
tokens/

# Local config — copy domestique.example.yaml to domestique.yaml
domestique.yaml

# Route data never lives in this repo: it is personal location data, and the
# whole point of the source split is that it stays somewhere private.
/routes/
data/

# State — rebuilt from the providers, not source
.domestique-state.json
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Not committed on purpose. It let an incomplete apps/api/go.sum pass locally
# while the Docker build — which copies only the module, with no workspace —
# failed on a missing checksum.
go.work.sum

# Build output
bin/
dist/
node_modules/
*.tsbuildinfo

# Generated by the Nuxt UI vite plugin
auto-imports.d.ts
components.d.ts

# Generated artifacts
out/
*.fit

# OS
.DS_Store
